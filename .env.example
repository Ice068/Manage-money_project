# Copy this file to .env for local development. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Leave DATABASE_URL empty to use the local SQLite database.
DATABASE_URL=

# For production only. Set all three together in the hosting provider's secret settings.
# APP_ENV=production
# APP_USERNAME=
# APP_PASSWORD_HASH=
# APP_SECRET_KEY=
